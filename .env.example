# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.
# No perfil dev, o Spring lê este arquivo automaticamente; o docker compose também.
# Linhas comentadas usam o valor padrão do perfil dev. Descomente só o que quiser sobrescrever
# (uma variável vazia sobrescreve o padrão com texto vazio).

# --- Obrigatórias ---------------------------------------------------------
# Senha local do RabbitMQ (qualquer valor; usada pelo docker compose e pela aplicação)
RABBITMQ_PASSWORD=
# Chave da IA (necessária para as funcionalidades de voz)
ANTHROPIC_API_KEY=
# Segredo usado pela API .NET para assinar os tokens JWT (mínimo de 32 caracteres).
# Precisa ser exatamente o mesmo configurado no .NET. A aplicação não inicia sem ele.
JWT_SECRET=
# Emissor do token (claim iss) configurado no .NET. Recomendado: sem ele o emissor não é verificado.
JWT_ISSUER=

# --- Opcionais ------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=dev
# ANTHROPIC_MODEL=claude-sonnet-5
# MONGODB_URI=mongodb://localhost:27017/vozviva
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=vozviva
# EUREKA_ENABLED=false

# --- JWT (opcionais) -------------------------------------------------------
# JWT_AUDIENCE=vozviva-api
# JWT_ALGORITMO=HS256
# JWT_JWKS_URI=https://api-dotnet/.well-known/jwks.json   (alternativa ao JWT_SECRET)

# --- A partir da SPEC-011 -------------------------------------------------
# DOTNET_API_URL=http://localhost:5000
