# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.
# No perfil dev, o Spring lê este arquivo automaticamente; o docker compose também.

# Perfil ativo (dev | prod)
SPRING_PROFILES_ACTIVE=dev

# IA (obrigatória para as funcionalidades de voz)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# MongoDB (dev: padrão mongodb://localhost:27017/vozviva)
MONGODB_URI=

# RabbitMQ (dev: padrão localhost / vozviva / vozviva)
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Integração com a API .NET e JWT (usados a partir das SPEC-002 e SPEC-011)
DOTNET_API_URL=http://localhost:5000
JWT_ISSUER=
JWT_SECRET=

# Service discovery (opcional)
EUREKA_ENABLED=false
