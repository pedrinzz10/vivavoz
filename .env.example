# Copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.
# No perfil dev, o Spring lê este arquivo automaticamente; o docker compose também.
# Linhas comentadas usam o valor padrão do perfil dev. Descomente só o que quiser sobrescrever
# (uma variável vazia sobrescreve o padrão com texto vazio).

# --- Obrigatórias ---------------------------------------------------------
# Senha do SQL Server local (usuário sa). Regra do SQL Server: 8+ caracteres com
# maiúscula, minúscula e número. Usada pelo docker compose e pela aplicação.
DB_PASSWORD=
# Senha local do RabbitMQ (qualquer valor; usada pelo docker compose e pela aplicação)
RABBITMQ_PASSWORD=
# Segredo de assinatura do JWT (mínimo de 32 caracteres). A API .NET valida com o mesmo valor.
# A aplicação não inicia sem ele.
JWT_SECRET=
# Emissor do token (claim iss). Recomendado: sem ele o emissor não é verificado.
JWT_ISSUER=
# Chave da IA (necessária para as funcionalidades de IA)
ANTHROPIC_API_KEY=
# Senha dos usuários de teste (cidadao.teste@vozviva.dev e cuidador.teste@vozviva.dev),
# criados automaticamente no perfil dev. 8+ caracteres com letra e número.
USUARIOS_TESTE_SENHA=

# --- Opcionais ------------------------------------------------------------
# SPRING_PROFILES_ACTIVE=dev
# ANTHROPIC_MODEL=claude-sonnet-5
# DB_URL=jdbc:sqlserver://localhost:1433;databaseName=vozviva;encrypt=true;trustServerCertificate=true
# DB_USERNAME=sa
# RABBITMQ_HOST=localhost
# RABBITMQ_PORT=5672
# RABBITMQ_USERNAME=vozviva

# --- JWT (opcionais) -------------------------------------------------------
# JWT_AUDIENCE=vozviva-api
# JWT_ALGORITMO=HS256
# JWT_EXPIRACAO=2h
# USUARIOS_TESTE_HABILITADO=true   (no perfil prod o padrão é false)
