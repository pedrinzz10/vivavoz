        <mxCell id="c43" value="&lt;b style=&quot;font-size:14px&quot;&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2563EB&quot;&gt;■&lt;/span&gt; recurso na Azure&lt;br&gt;&lt;span style=&quot;color:#1D4ED8&quot;&gt;■&lt;/span&gt; aplicação (App Service)&lt;br&gt;&lt;span style=&quot;color:#EA580C&quot;&gt;■&lt;/span&gt; sistema externo&lt;br&gt;&lt;span style=&quot;color:#16A34A&quot;&gt;■&lt;/span&gt; Azure DevOps (CI/CD)&lt;br&gt;── requisição síncrona&lt;br&gt;- - - assíncrono / carga&lt;br&gt;&lt;span style=&quot;color:#15803D&quot;&gt;- - -&lt;/span&gt; build e deploy&lt;br&gt;&lt;span style=&quot;color:#C2410C&quot;&gt;──&lt;/span&gt; chamada à IA (Spring AI)&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Fluxos numerados: ver README, seção &quot;Arquitetura&quot;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="470" width="230" height="230" as="geometry"/></mxCell>
