<mxfile host="app.diagrams.net" agent="VozViva" version="24.0.0">
  <diagram id="arquitetura-vozviva" name="Arquitetura VozViva">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c3" value="&lt;b style=&quot;font-size:22px&quot;&gt;VozViva - arquitetura macro (Fala Cidadão / CitizenTech)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;API Java (Spring Boot 4, Java 21) para pessoas idosas e com deficiência: voz, socorro, rede de apoio, golpes e atendimento acessível&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1200" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="Microsoft Azure - grupo rg-vozviva (scripts/provisionar-azure.sh)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontStyle=1;fontSize=14;fillColor=#F8FAFC;strokeColor=#2563EB;dashed=1;fontColor=#1D4ED8;" vertex="1" parent="1"><mxGeometry x="300" y="100" width="600" height="560" as="geometry"/></mxCell>
        <mxCell id="c5" value="Azure DevOps - Boards, Repos e Pipelines (azure-pipeline.yml)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;fontStyle=1;fontSize=14;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#15803D;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="940" height="150" as="geometry"/></mxCell>
        <mxCell id="c6" value="&lt;b style=&quot;font-size:14px&quot;&gt;App Service (container Linux)&lt;/b&gt;&lt;br&gt;API Java VozViva - imagem do ACR&lt;br&gt;• Auth: cadastro (consentimento LGPD), login, JWT&lt;br&gt;• Exclusão da conta (DELETE /auth/eu)&lt;br&gt;• Voz: intenção (Spring AI + RAG)&lt;br&gt;• Emergência: publica e consome eventos&lt;br&gt;• Perfil e contatos (cidadão ou cuidador)&lt;br&gt;• Golpes (Spring AI + RAG + regras)&lt;br&gt;• Atendimento acessível (OpenStreetMap)&lt;br&gt;Swagger em /swagger-ui.html" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="330" y="140" width="320" height="210" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;Azure SQL (PaaS)&lt;/b&gt;&lt;br&gt;Banco vozviva - Spring Data JPA + Flyway&lt;br&gt;usuário vozviva_app (privilégio mínimo)&lt;br&gt;usuarios, perfis, contatos, emergencias,&lt;br&gt;avisos, verificacoes_golpe, interacoes_voz,&lt;br&gt;pontos_atendimento, contas_excluidas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="330" y="420" width="320" height="120" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b style=&quot;font-size:14px&quot;&gt;RabbitMQ (ACI)&lt;/b&gt;&lt;br&gt;só IP privado na VNet&lt;br&gt;exchange vozviva.emergencias&lt;br&gt;fila .acionadas + DLQ&lt;br&gt;retry com espera crescente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="690" y="140" width="190" height="120" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:14px&quot;&gt;Container Registry (ACR)&lt;/b&gt;&lt;br&gt;imagem vozviva-api&lt;br&gt;tag = número do build&lt;br&gt;pull por identidade gerenciada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="690" y="420" width="190" height="100" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rede virtual (VNet)&lt;/b&gt;&lt;br&gt;snet-app: integração do App Service&lt;br&gt;snet-rabbitmq: RabbitMQ privado" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="690" y="290" width="190" height="80" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:14px&quot;&gt;App mobile (React Native)&lt;/b&gt;&lt;br&gt;voz e toque&lt;br&gt;transcreve a fala e abre a tela&lt;br&gt;que a API indica&lt;br&gt;rota no Google Maps / Waze" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="210" height="110" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b style=&quot;font-size:14px&quot;&gt;API .NET (Oracle)&lt;/b&gt;&lt;br&gt;zeladoria e cadastros oficiais&lt;br&gt;valida o mesmo JWT&lt;br&gt;iss=voz-e-via-java, aud=voz-e-via" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="40" y="400" width="210" height="100" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:14px&quot;&gt;Oracle Cloud (OCI)&lt;/b&gt;&lt;br&gt;Generative AI - endpoint compatível&lt;br&gt;com OpenAI (openai.gpt-oss-120b)&lt;br&gt;sem IA: regras determinísticas" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="960" y="150" width="260" height="100" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b style=&quot;font-size:14px&quot;&gt;OpenStreetMap&lt;/b&gt;&lt;br&gt;Overpass API - importação única&lt;br&gt;./gradlew importarOsm (licença ODbL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="960" y="420" width="260" height="80" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Boards + Repos&lt;/b&gt;&lt;br&gt;tarefa → branch → PR&lt;br&gt;main protegida" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="320" y="740" width="200" height="80" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b style=&quot;font-size:14px&quot;&gt;Build (CI) a cada merge na main&lt;/b&gt;&lt;br&gt;Gradle: testes JUnit + JaCoCo publicados&lt;br&gt;pacote (jar, OpenAPI, script) + imagem" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="560" y="740" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b style=&quot;font-size:14px&quot;&gt;Release (CD) automática&lt;/b&gt;&lt;br&gt;nova imagem no App Service&lt;br&gt;conferência do /actuator/health" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="900" y="740" width="300" height="80" as="geometry"/></mxCell>
        <mxCell id="c18" value="1 HTTPS + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#334155;" edge="1" parent="1" source="c11" target="c6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c19" value="5 mesmo JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#334155;" edge="1" parent="1" source="c11" target="c12"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c20" value="2 JPA / Flyway" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;strokeColor=#334155;" edge="1" parent="1" source="c6" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;startArrow=block;startFill=1;strokeColor=#334155;dashed=1;" edge="1" parent="1" source="c6" target="c8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c22" value="4 Spring AI (RAG)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#C2410C;" edge="1" parent="1" source="c6" target="c13"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="490" y="115"/><mxPoint x="1090" y="115"/></Array></mxGeometry></mxCell>
        <mxCell id="c23" value="7 carga (migração R__)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#334155;dashed=1;" edge="1" parent="1" source="c14" target="c7"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="925" y="460"/><mxPoint x="925" y="560"/><mxPoint x="490" y="560"/></Array></mxGeometry></mxCell>
        <mxCell id="c24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#15803D;dashed=1;" edge="1" parent="1" source="c15" target="c16"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#15803D;dashed=1;" edge="1" parent="1" source="c16" target="c17"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c26" value="6 imagem" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#15803D;dashed=1;" edge="1" parent="1" source="c16" target="c9"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c27" value="6 deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#15803D;dashed=1;" edge="1" parent="1" source="c17" target="c6"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1050" y="680"/><mxPoint x="670" y="680"/><mxPoint x="670" y="330"/></Array></mxGeometry></mxCell>
        <mxCell id="c28" value="&lt;b style=&quot;font-size:14px&quot;&gt;Legenda&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;color:#2563EB&quot;&gt;■&lt;/span&gt; recurso na Azure&lt;br&gt;&lt;span style=&quot;color:#EA580C&quot;&gt;■&lt;/span&gt; sistema externo&lt;br&gt;&lt;span style=&quot;color:#16A34A&quot;&gt;■&lt;/span&gt; Azure DevOps (CI/CD)&lt;br&gt;── requisição síncrona&lt;br&gt;- - - assíncrono / carga&lt;br&gt;&lt;span style=&quot;color:#15803D&quot;&gt;- - -&lt;/span&gt; build e deploy&lt;br&gt;&lt;span style=&quot;color:#C2410C&quot;&gt;──&lt;/span&gt; chamada à IA (Spring AI)&lt;br&gt;&lt;span style=&quot;font-size:11px&quot;&gt;Números = fluxos descritos no README&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#CBD5E1;arcSize=4;" vertex="1" parent="1"><mxGeometry x="40" y="560" width="220" height="180" as="geometry"/></mxCell>
      </root>
