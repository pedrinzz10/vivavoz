<mxfile host="app.diagrams.net" agent="VozViva" version="24.0.0">
  <diagram id="arquitetura-vozviva" name="Arquitetura VozViva">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1240" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c3" value="&lt;b style=&quot;font-size:22px&quot;&gt;VozViva - arquitetura macro (Fala Cidadão / CitizenTech)&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:13px;color:#475569&quot;&gt;API Java (Spring Boot 4, Java 21) e API .NET de zeladoria para pessoas idosas e com deficiência: voz, socorro, golpes e atendimento acessível&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="16" width="1180" height="60" as="geometry"/></mxCell>
        <mxCell id="c4" value="Microsoft Azure - rg-vozviva (brazilsouth), criado por scripts/provisionar-azure.sh" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=bottom;align=left;spacingLeft=12;spacingBottom=6;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F8FAFC;strokeColor=#2563EB;dashed=1;fontColor=#1D4ED8;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="290" y="100" width="640" height="530" as="geometry"/></mxCell>
        <mxCell id="c5" value="App Service Plan B1 (Linux)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingBottom=6;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#FFFFFF;strokeColor=#93C5FD;dashed=1;fontColor=#1D4ED8;fontSize=11;spacingLeft=34;" vertex="1" parent="1"><mxGeometry x="306" y="116" width="320" height="364" as="geometry"/></mxCell>
        <mxCell id="c6" value="Azure DevOps - Boards, Repos e Pipelines (azure-pipeline.yml)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=3;verticalAlign=top;align=left;spacingLeft=12;spacingBottom=6;spacingTop=4;fontStyle=1;fontSize=13;fillColor=#F0FDF4;strokeColor=#16A34A;fontColor=#15803D;spacingLeft=44;" vertex="1" parent="1"><mxGeometry x="290" y="670" width="910" height="160" as="geometry"/></mxCell>
        <mxCell id="c7" value="&lt;b style=&quot;font-size:14px&quot;&gt;API Java VozViva (container)&lt;/b&gt;&lt;br&gt;imagem do ACR; JVM limitada a 40%&lt;br&gt;• Auth: cadastro, login, JWT, conta (LGPD)&lt;br&gt;• Voz: intenção (Spring AI + RAG)&lt;br&gt;• Emergência: publica e consome eventos&lt;br&gt;• Perfil e contatos (CRUD paginado)&lt;br&gt;• Golpes (Spring AI + RAG + regras)&lt;br&gt;• Atendimento acessível (OpenStreetMap)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="148" width="292" height="190" as="geometry"/></mxCell>
        <mxCell id="c8" value="&lt;b style=&quot;font-size:14px&quot;&gt;API .NET de zeladoria (.NET 8)&lt;/b&gt;&lt;br&gt;reportes, fotos e painel do gestor&lt;br&gt;valida o mesmo JWT (role e orgao)&lt;br&gt;fotos em /home/uploads (persistente)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#DBEAFE;strokeColor=#1D4ED8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="320" y="362" width="292" height="104" as="geometry"/></mxCell>
        <mxCell id="c9" value="&lt;b style=&quot;font-size:14px&quot;&gt;RabbitMQ (ACI, 0,5 vCPU)&lt;/b&gt;&lt;br&gt;só IP privado na VNet&lt;br&gt;exchange vozviva.emergencias&lt;br&gt;fila .acionadas + DLQ&lt;br&gt;retry com espera crescente" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="652" y="148" width="262" height="118" as="geometry"/></mxCell>
        <mxCell id="c10" value="&lt;b style=&quot;font-size:14px&quot;&gt;Rede virtual (VNet)&lt;/b&gt;&lt;br&gt;snet-app (APIs) e snet-rabbitmq" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="652" y="280" width="262" height="58" as="geometry"/></mxCell>
        <mxCell id="c11" value="&lt;b style=&quot;font-size:14px&quot;&gt;Azure SQL (PaaS) - 2 bancos&lt;/b&gt;&lt;br&gt;vozviva: JPA + Flyway (API Java)&lt;br&gt;zeladoria: EF Core (API .NET)&lt;br&gt;usuário vozviva_app em cada banco&lt;br&gt;(privilégio mínimo)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="652" y="362" width="262" height="134" as="geometry"/></mxCell>
        <mxCell id="c12" value="&lt;b style=&quot;font-size:14px&quot;&gt;Container Registry (ACR)&lt;/b&gt;&lt;br&gt;imagem vozviva-api (tag = build)&lt;br&gt;pull por identidade gerenciada" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="652" y="512" width="262" height="88" as="geometry"/></mxCell>
        <mxCell id="c13" value="&lt;b style=&quot;font-size:14px&quot;&gt;Orçamento do grupo&lt;/b&gt;&lt;br&gt;gasto acumulado; alerta em 50% e 80%" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#EFF6FF;strokeColor=#2563EB;" vertex="1" parent="1"><mxGeometry x="320" y="512" width="292" height="66" as="geometry"/></mxCell>
        <mxCell id="c14" value="&lt;b style=&quot;font-size:14px&quot;&gt;App mobile&lt;/b&gt;&lt;br&gt;React Native - voz e toque&lt;br&gt;transcreve a fala, abre a&lt;br&gt;tela que a API indica e a rota&lt;br&gt;no Google Maps / Waze" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="40" y="170" width="220" height="120" as="geometry"/></mxCell>
        <mxCell id="c15" value="&lt;b style=&quot;font-size:14px&quot;&gt;Oracle Cloud (OCI)&lt;/b&gt;&lt;br&gt;Generative AI, São Paulo&lt;br&gt;endpoint compatível com OpenAI&lt;br&gt;(openai.gpt-oss-120b)&lt;br&gt;sem IA: regras respondem" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="960" y="148" width="240" height="130" as="geometry"/></mxCell>
        <mxCell id="c16" value="&lt;b style=&quot;font-size:14px&quot;&gt;OpenStreetMap&lt;/b&gt;&lt;br&gt;Overpass API - importação única&lt;br&gt;(./gradlew importarOsm, ODbL)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFF7ED;strokeColor=#EA580C;" vertex="1" parent="1"><mxGeometry x="960" y="300" width="240" height="90" as="geometry"/></mxCell>
        <mxCell id="c17" value="&lt;b style=&quot;font-size:14px&quot;&gt;Boards + Repos&lt;/b&gt;&lt;br&gt;tarefa → branch → PR&lt;br&gt;main protegida (revisor,&lt;br&gt;tarefa vinculada)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="306" y="718" width="190" height="92" as="geometry"/></mxCell>
        <mxCell id="c18" value="&lt;b style=&quot;font-size:14px&quot;&gt;Build (CI) a cada merge na main&lt;/b&gt;&lt;br&gt;Gradle: testes JUnit + JaCoCo publicados&lt;br&gt;pacote (jar, OpenAPI, script do banco)&lt;br&gt;e imagem enviada ao ACR" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="540" y="718" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="c19" value="&lt;b style=&quot;font-size:14px&quot;&gt;Release (CD) automática&lt;/b&gt;&lt;br&gt;nova imagem na API Java&lt;br&gt;e conferência da readiness&lt;br&gt;(/actuator/health/readiness)" style="rounded=1;whiteSpace=wrap;html=1;arcSize=6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=12;fillColor=#FFFFFF;strokeColor=#16A34A;" vertex="1" parent="1"><mxGeometry x="880" y="718" width="300" height="92" as="geometry"/></mxCell>
        <mxCell id="c20" value="1 HTTPS + JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.43;entryDx=0;entryDy=0;strokeColor=#334155;" edge="1" parent="1" source="c14" target="c7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell>
        <mxCell id="c21" value="5 mesmo JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeWidth=2;fontSize=11;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#334155;" edge="1" parent="1" source="c14" target="c8"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="150" y="414"/></Array></mxGeometry></mxCell>
